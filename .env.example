# Use a separate Supabase project for dev preview and main production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional map UI; manual pin coordinates work without this token.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Auth SMTP is configured in Supabase Dashboard; these power booking email.
RESEND_API_KEY=
EMAIL_FROM="BookedIn <booking@example.com>"
CRON_SECRET=

# Fill these with real operator details before publishing the privacy notice.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Keep false until all launch checks pass, then also open the database gate.
BOOKING_LAUNCH_READY=false
